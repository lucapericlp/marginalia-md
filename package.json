{
  "name": "marginalia-md",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "build:release": "tsc --noEmit && node esbuild.config.mjs --production",
    "lint": "eslint src --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "check:release": "node scripts/check-release.mjs",
    "package": "npm run build:release && npm run check:release && node scripts/package.mjs",
    "install:vault": "node scripts/install.mjs",
    "build:dev": "tsc --noEmit && node esbuild.config.mjs --development",
    "lint:css": "node scripts/check-css.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "decode-named-character-reference": "^1.2.0",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "doiuse": "6.0.6",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "obsidian": "1.14.4",
    "postcss": "8.5.31",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.0"
  },
  "description": "Paragraph and passage margin notes in Obsidian, stored as readable Markdown footnotes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucapericlp/marginalia-md.git"
  },
  "bugs": {
    "url": "https://github.com/lucapericlp/marginalia-md/issues"
  },
  "homepage": "https://github.com/lucapericlp/marginalia-md#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
